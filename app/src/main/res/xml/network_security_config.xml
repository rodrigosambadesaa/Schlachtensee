<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The real temperature backend supports HTTPS. Never permit cleartext
         traffic or trust user-added CA certificates for this application. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
