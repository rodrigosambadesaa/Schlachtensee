<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Keep legacy HTTP access only for the existing temperature backend.
         Other domains use Android's default TLS certificate/hostname validation. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">jmnberlin.de</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
